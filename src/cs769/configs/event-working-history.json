{
  "extends": "_base.json",
  "name": "event-working-history",
  "memory": {
    "kind": "semantic",
    "options": {
      "kind": "event",
      "codec": "tables-v1",
      "semantics": "mixed",
      "explanation": "minimal"
    }
  },
  "checkpoint": {
    "kind": "history_tokens",
    "threshold": 1000,
    "counter": "history_json",
    "strict": true
  },
  "model": {
    "sampling": {
      "temperature": 0,
      "seed": 42,
      "max_tokens": 4096
    }
  }
}
